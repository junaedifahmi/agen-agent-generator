# Copy this file to .env and fill in your values.

# OpenRouter API key (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# OpenRouter model id to use for the elicitor agent.
# Any OpenRouter-hosted model works; pick one with strong instruction-following
# and structured-output support since Agen extracts a Pydantic-validated spec.
AGEN_MODEL_ID=openai/gpt-5-mini

# Path to the local SQLite file used for session storage (conversation state).
AGEN_DB_FILE=agen_sessions.db

# Directory where finished elicitation specs are written as YAML.
AGEN_SPEC_OUTPUT_DIR=specs

# Max output tokens per model call. Agno's OpenRouter model defaults to
# 1024, which is too low once Agen starts calling set_persona with a full
# drafted system_prompt as one of the tool arguments -- the response gets
# cut off mid-JSON and fails to parse. Raise this further if you see
# "Unable to decode function arguments" / "unterminated string" errors.
AGEN_MAX_TOKENS=4096
